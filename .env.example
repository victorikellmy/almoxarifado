# =============================================================================
# Variaveis de ambiente da aplicacao (container de producao).
# Copie para .env e preencha - o .env NUNCA e versionado (.gitignore).
# =============================================================================

# ----- Banco PostgreSQL (OBRIGATORIO - sem isso o boot falha) -----
# Opcao A: URL unica (tem precedencia sobre as variaveis separadas)
#   formato: postgresql://usuario:senha@host:5432/banco
DATABASE_URL=

# Opcao B: variaveis separadas
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ----- Bootstrap do administrador -----
# Usados SOMENTE no primeiro boot com a tabela de usuarios vazia.
# ADMIN_PASSWORD e OBRIGATORIA nesse primeiro boot (sem default).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ----- HTTP -----
# Porta interna da aplicacao (opcional, default 8080)
PORT=8080

# ----- Uploads -----
# Diretorio unico de escrita da app - monte um volume aqui.
# (opcional, default /data/uploads)
UPLOADS_DIR=/data/uploads

# ----- Integracao com o Gerenciador Patrimonial (opcional) -----
# Sem PATRIMONIO_URL a integracao fica desligada e os envios aguardam na fila.
# Usuario/senha do usuario tecnico criado no Patrimonio (INTEGRACAO_ALMOXARIFADO_SENHA la).
PATRIMONIO_URL=
PATRIMONIO_USUARIO=integracao.almoxarifado
PATRIMONIO_SENHA=
# Intervalo do reenvio automatico dos pendentes, em ms (opcional, default 600000)
PATRIMONIO_REENVIO_MS=600000

# ----- Setor de Compras -----
# Senha inicial de delva.maria / sarah.luz / daisy.dias (opcional, default Famsaudepm.)
COMPRAS_SENHA_INICIAL=
